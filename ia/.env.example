# Copier en ia/.env (jamais commité) puis remplir.
# Adresse de l'API Sentinel-X (sur le serveur : http://192.168.10.1:3000)
API_URL=http://localhost:3000
# Clé API du serveur (contenu de infra/secrets/api_key.txt)
API_KEY=

# --- Vision (vision.py) ---
# Numéro de la webcam (0 = la première)
CAMERA=0
# Modèle YOLOv8n au format ONNX (voir ia/README.md pour l'obtenir)
MODEL=models/yolov8n-320.onnx
# Confiance minimale pour retenir une personne (0 à 1)
CONFIDENCE=0.5
# Port du flux vidéo MJPEG affiché par le dashboard
VIDEO_PORT=5000

# --- Anomalies (anomalies.py) ---
# Secondes entre deux analyses de la télémétrie
POLL_SECONDS=5
