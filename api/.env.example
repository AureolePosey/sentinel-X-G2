# Copie ce fichier en ".env" puis remplis les valeurs. Le fichier .env ne doit JAMAIS aller dans Git.

# Port HTTP de l'API et du dashboard
PORT=3000

# Identifiant du groupe (utilisé dans les topics MQTT : sentinel/<GROUP_ID>/...)
GROUP_ID=g2

# Clé exigée dans l'en-tête X-API-Key pour POST /alerts et POST /commands
# Génère-en une longue et aléatoire, par exemple : node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=change-moi

# Broker MQTT
# Sans TLS (développement) : mqtt://localhost:1883
# Avec TLS (version finale) : mqtts://localhost:8883  + MQTT_CA_FILE
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Chemin du certificat de l'autorité (CA) fourni par l'équipe cloud, si TLS
MQTT_CA_FILE=

# Base PostgreSQL. Laisse vide pour utiliser la mémoire (pratique pour commencer, mais tout est perdu au redémarrage)
# Exemple : postgres://sentinel:motdepasse@localhost:5432/sentinel
DATABASE_URL=

# Adresse du flux vidéo MJPEG diffusé par le script IA
VIDEO_URL=http://localhost:5000/video

# Seuils des alertes physiques
GAS_THRESHOLD=400
TEMP_THRESHOLD=40
# Secondes sans message avant de déclarer le boîtier hors ligne
OFFLINE_AFTER=10
